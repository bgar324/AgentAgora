# Required for focused GPT-5.6 calls, embeddings, and legacy evidence search.
OPENAI_API_KEY=

# Required only by the legacy Agent Agora workflow.
OPENROUTER_API_KEY=

# Optional but strongly recommended for Semantic Scholar rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# Set AGORA_PERSISTENCE=supabase in Railway after applying the migration.
AGORA_PERSISTENCE=sqlite
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Shared only by the Vercel server proxy and Railway API.
AGORA_PROXY_TOKEN=

# PI directive: keep every model route on GPT-5.6 Luna.
AGORA_BRIEF_MODEL=openai/gpt-5.6-luna
AGORA_PANEL_MODEL=openai/gpt-5.6-luna
AGORA_DELIBERATION_MODEL=openai/gpt-5.6-luna

# Focused workflow routes use direct OpenAI model IDs.
AGORA_FOCUSED_CORPUS_MODEL=gpt-5.6-luna
AGORA_FOCUSED_QUERY_MODEL=gpt-5.6-luna
AGORA_FOCUSED_REASONING_MODEL=gpt-5.6-luna
AGORA_FOCUSED_EVALUATION_MODEL=gpt-5.6-luna

# Local runtime defaults.
AGORA_DATA_DIR=artifacts
AGORA_CORS_ORIGINS=http://localhost:3000
